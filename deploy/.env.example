# Copy to deploy/.env and adjust. Compose passes each secret only to services that need it.
#   cp deploy/.env.example deploy/.env

# ---------------------------------------------------------------------------
# Compose project
# ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=openswe

# Host ports (map container ports to these on localhost)
API_HOST_PORT=8080
UI_HOST_PORT=3005
WEBHOOK_HOST_PORT=8081
POSTGRES_HOST_PORT=5432
NATS_HOST_PORT=4222
NATS_MONITOR_HOST_PORT=8222
LITELLM_HOST_PORT=4000

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
POSTGRES_USER=openswe
POSTGRES_PASSWORD=openswe
POSTGRES_DB=openswe
# Used by app containers (hostname = compose service name)
DATABASE_URL=postgresql+asyncpg://openswe:openswe@postgres:5432/openswe

# ---------------------------------------------------------------------------
# NATS JetStream
# ---------------------------------------------------------------------------
NATS_URL=nats://nats:4222

# ---------------------------------------------------------------------------
# LLM — direct providers (default) and optional LiteLLM
# ---------------------------------------------------------------------------
# LLM_MODE=auto|direct|litellm
#   auto   — use LiteLLM only if LITELLM_ENABLED=true; else direct if keys set
#   direct — always call OpenAI/Anthropic/Fireworks/Google APIs
#   litellm — always use LiteLLM proxy
LLM_MODE=auto
LITELLM_ENABLED=false
LITELLM_BASE_URL=
LITELLM_API_KEY=sk-litellm
LITELLM_MASTER_KEY=sk-litellm

# Direct provider keys (used when LLM_MODE=direct or auto without LiteLLM)
DEFAULT_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
GOOGLE_API_KEY=

# Model ids: openai:gpt-4o-mini | anthropic:claude-sonnet-4-20250514 | …
DEFAULT_MODEL=openai:gpt-4o-mini

# ---------------------------------------------------------------------------
# Platform defaults
# ---------------------------------------------------------------------------
DEFAULT_SANDBOX_PROVIDER=local
DEFAULT_ORG_ID=00000000-0000-4000-8000-000000000001
DEFAULT_USER_ID=00000000-0000-4000-8000-000000000002
API_AUTH_DISABLED=true
PLATFORM_API_TOKEN=
PLATFORM_JWT_SECRET=
CORS_ORIGINS=http://localhost:3005

# Harness lease / retries
LEASE_TTL_SECONDS=60
HEARTBEAT_INTERVAL_SECONDS=15
MAX_RUN_DURATION_SECONDS=14400
MAX_RUN_RETRIES=3
OUTBOX_POLL_INTERVAL_SECONDS=1

# Required before storing MCP credentials: Fernet key for secrets at rest
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Sandbox providers. Stub mode is explicit and intended only for local UI testing.
# ---------------------------------------------------------------------------
ALLOW_STUB_SANDBOXES=true
LOCAL_SANDBOX_ROOT_DIR=/workspace
DAYTONA_API_KEY=
DAYTONA_SANDBOX_SNAPSHOT=daytonaio/sandbox:0.6.0
OPENSANDBOX_BASE_URL=
OPENSANDBOX_API_KEY=
AGENT_SANDBOX_NAMESPACE=agent-sandboxes
MCP_STDIO_ALLOWED=false
MCP_ALLOW_PRIVATE_NETWORKS=false
MCP_TOOL_TIMEOUT_SECONDS=120
MAX_MCP_SERVERS_PER_RUN=10

# ---------------------------------------------------------------------------
# Webhook secrets (optional in local; empty = signature checks skipped)
# ---------------------------------------------------------------------------
GITHUB_WEBHOOK_SECRET=
SLACK_SIGNING_SECRET=
WEBHOOK_SIGNATURES_REQUIRED=false

# ---------------------------------------------------------------------------
# Harness identity (overridden per replica with hostname in compose)
# ---------------------------------------------------------------------------
WORKER_ID=harness-1
